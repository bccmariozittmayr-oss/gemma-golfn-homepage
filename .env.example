# Gemma Golfn Homepage - WordPress Zugangsdaten
# KEINE echten Werte hier eintragen! Dies ist nur die Vorlage.
# Echte Werte gehoeren in die .env Datei (die NICHT in Git/Cloud landet).

WP_URL=https://deine-domain.at
WP_USER=dein-benutzername
WP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Hetzner Zugangsdaten
HETZNER_USER=dein-hetzner-benutzername
HETZNER_PASSWORD=dein-hetzner-passwort
HETZNER_API_TOKEN=dein-hetzner-api-token
